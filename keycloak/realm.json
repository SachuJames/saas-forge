{
  "clients": [
    {
      "clientId": "saaskit-app",
      "directAccessGrantsEnabled": true,
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ]
    }
  ],
  "enabled": true,
  "realm": "saaskit",
  "roles": {
    "realm": [
      {
        "description": "TenantKit administrator",
        "name": "admin"
      },
      {
        "description": "Tenant user",
        "name": "user"
      }
    ]
  },
  "users": [
    {
      "credentials": [
        {
          "temporary": false,
          "type": "password",
          "value": "admin"
        }
      ],
      "email": "admin@tenantkit.local",
      "enabled": true,
      "realmRoles": [
        "admin"
      ],
      "username": "admin"
    },
    {
      "credentials": [
        {
          "temporary": false,
          "type": "password",
          "value": "demo"
        }
      ],
      "email": "demo@tenantkit.local",
      "enabled": true,
      "realmRoles": [
        "user"
      ],
      "username": "demo",
      "attributes": {
        "tenant_id": [
          "demo-tenant"
        ]
      }
    }
  ],
  "protocolMappers": [
    {
      "name": "tenant_id",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "userinfo.token.claim": "true",
        "user.attribute": "tenant_id",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "claim.name": "tenant_id",
        "jsonType.label": "String"
      }
    }
  ]
}